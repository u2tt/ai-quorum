# ═══════════════════════════════════════════════════════════════
# AI QUORUM 配置示例
# 复制为 .env 后填写；也可以直接复用 ~/.quorum/.env
# 优先级：命令行 --env > 当前目录 .env > ~/.quorum/.env
# ═══════════════════════════════════════════════════════════════

# ── DeepSeek（云端，性价比首选）────────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

# ── 国产厂商（填了 key 就会自动出现在模型列表里）────────────────
# 智谱 GLM：https://open.bigmodel.cn/usercenter/apikeys
# GLM_API_KEY=
# 同厂别名，二选一即可
# ZHIPU_API_KEY=
# GLM_MODELS=glm-4.6,glm-4.5,glm-4.5-air,glm-4.5-flash

# MiniMax：https://platform.minimaxi.com/user-center/basic-information/interface-key
# MINIMAX_API_KEY=
# MINIMAX_MODELS=MiniMax-M2,MiniMax-Text-01

# 月之暗面 Kimi：https://platform.moonshot.cn/console/api-keys
# MOONSHOT_API_KEY=
# 同厂别名，二选一即可
# KIMI_API_KEY=
# MOONSHOT_MODELS=kimi-k2-0905-preview,kimi-k2-turbo-preview,moonshot-v1-128k

# 阿里通义千问（百炼 OpenAI 兼容模式）：https://bailian.console.aliyun.com/
# DASHSCOPE_API_KEY=
# 同厂别名，二选一即可
# QWEN_API_KEY=
# QWEN_MODELS=qwen3-max,qwen-plus,qwen-turbo

# 硅基流动：https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=
# SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V3.2-Exp,Qwen/Qwen3-235B-A22B-Instruct-2507

# 火山方舟（豆包）：https://console.volcengine.com/ark
# ARK_API_KEY=
# 同厂别名，二选一即可
# DOUBAO_API_KEY=
# ARK_MODELS=doubao-seed-1.6,doubao-1.5-pro-32k

# 阶跃星辰：https://platform.stepfun.com/interface-key
# STEPFUN_API_KEY=
# STEPFUN_MODELS=step-2-16k

# 百川智能：https://platform.baichuan-ai.com/console/apikey
# BAICHUAN_API_KEY=
# BAICHUAN_MODELS=Baichuan4-Turbo,Baichuan4

# ── 海外厂商 ──────────────────────────────────────────────────
# OpenAI ────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODELS=gpt-5.2,gpt-5.1

# ── Anthropic（走原生 /v1/messages 协议）──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODELS=claude-opus-4-5-20251124,claude-sonnet-4-5-20250929

# ── Google（走 OpenAI 兼容层）────────────────────────────────
# GOOGLE_API_KEY=...
# GOOGLE_MODELS=gemini-3-pro,gemini-2.5-flash

# ── xAI ───────────────────────────────────────────────────────
# XAI_API_KEY=xai-...
# XAI_MODELS=grok-4.1,grok-4

# ── OpenRouter（一个 key 访问 200+ 模型）──────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── LM Studio（本地，模型自动发现）────────────────────────────
# 不需要 API key，服务在 1234 端口即可被自动探测；端点要求鉴权时再填
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=
# LMSTUDIO_MODELS=qwen3.5-4b,gemma-4-e2b

# ── Ollama（本地，自动发现）───────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=
# OLLAMA_MODELS=qwen3:8b,llama3.2

# ── llama-swap（本地热切换，自动发现）─────────────────────────
# LLAMASWAP_BASE_URL=http://localhost:8080/v1
# LLAMASWAP_API_KEY=
# LLAMASWAP_MODELS=qwen3.5-4b,gemma-4-e2b

# ── 任意 OpenAI 兼容端点（vLLM / LocalAI / TabbyAPI ...）───────
# CUSTOM_BASE_URL=http://localhost:5000/v1
# CUSTOM_API_KEY=
# CUSTOM_MODELS=model-name-1,model-name-2

# ═══════════════════════════════════════════════════════════════
# 讨论行为
# ═══════════════════════════════════════════════════════════════

# 默认语言；留空则跟随话题语言
# QUORUM_DEFAULT_LANGUAGE=Chinese

# standard 方法中每位参与者发言轮数（默认 2）
QUORUM_ROUNDS_PER_AGENT=2

# 综合者：first（第一个模型）/ random / rotate
QUORUM_SYNTHESIZER=first

# 单模型响应超时秒数（本地小模型建议 120-300）
QUORUM_MODEL_TIMEOUT=120

# 并发策略：auto（云端并行、本地串行）/ parallel / sequential
QUORUM_EXECUTION_MODE=auto

# 单条发言最大 token；推理模型先消耗 reasoning，建议 ≥4096
QUORUM_MAX_TOKENS=4096

# 喂给模型的历史窗口上限（按字符）。超出时丢弃较早发言，最新一条超长则截断
# QUORUM_MAX_HISTORY_CHARS=24000

# 采样温度
QUORUM_TEMPERATURE=0.8

# 报告自动落盘目录
QUORUM_REPORT_DIR=~/reports

# 报告格式：md / text / json
QUORUM_EXPORT_FORMAT=md

# ═══════════════════════════════════════════════════════════════
# 存储与导出
# ═══════════════════════════════════════════════════════════════

# Web 会话与模型库的 SQLite 路径（默认 ~/.quorum/web.db）
# QUORUM_DB=~/.quorum/web.db

# 导出目录（默认 ~/.quorum/exports）
# 当前版本未使用，预留
# QUORUM_EXPORT_DIR=~/.quorum/exports
